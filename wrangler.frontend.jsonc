{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vvt-studio-v2",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "vvtdigital.vn/*",
      "zone_name": "vvtdigital.vn"
    }
  ]
}
